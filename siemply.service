[Unit]
Description=SIEMply Backend Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/SIEMPLY
Environment=PATH=/opt/SIEMPLY/venv/bin
Environment=PYTHONPATH=/opt/SIEMPLY
ExecStart=/opt/SIEMPLY/venv/bin/python /opt/SIEMPLY/backend/main.py --port 5050
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=siemply-backend

# Connection and timeout settings
TimeoutStartSec=60
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
